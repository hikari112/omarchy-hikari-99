[Unit]
Description=Keychron Q6 Max lighting in the Hikari 99 sky
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/.local/share/omarchy-hikari-99/keychron-glow.py
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=graphical-session.target
